#! /usr/bin/env bash
#
# Managed by Ansible (deploy/templates/vulpes.sh.j2); local edits will be overwritten.
#
# Runs the app with the release's own uvicorn (from its virtualenv), with production
# settings from shared/env and shared/secrets.env.
#
# Usage:
#   vulpes.sh start|stop|restart|reload|status
#   vulpes.sh import filtered_flat-YYYY_DD_MM.csv   rebuild the database, then reload if running
#
# reload swaps in fresh workers without downtime, e.g. to pick up a rebuilt database.
#
# Acts on the release that "current" points to, unless RELEASE_DIR is set.

set -euo pipefail

APP_ROOT={{ app_root }}
RELEASE_DIR=$(readlink -f "${RELEASE_DIR:-$APP_ROOT/current}")
PIDFILE=$APP_ROOT/shared/uvicorn.pid
LOG_DIR=$APP_ROOT/shared/log
WORKERS={{ uvicorn_workers }}

set -a
. "$APP_ROOT/shared/env"
. "$APP_ROOT/shared/secrets.env"
set +a

is_running() {
    [[ -f $PIDFILE ]] && ps -p "$(cat "$PIDFILE")" -o args= 2>/dev/null | grep -q uvicorn
}

start() {
    if is_running; then
        echo "already running (pid $(cat "$PIDFILE"))"
        return
    fi
    cd "$RELEASE_DIR"
    # uvicorn can't daemonize itself, so detach it from this shell with setsid/nohup.
    # Logging goes to stdout via logging.json, so the access and app logs share one file.
    setsid nohup "$RELEASE_DIR/.venv/bin/uvicorn" vulpes.main:app \
        --host {{ uvicorn_host }} \
        --port {{ uvicorn_port }} \
        --workers "$WORKERS" \
        --timeout-worker-healthcheck 60 \
        --root-path {{ root_path }} \
        --proxy-headers \
        --forwarded-allow-ips '*' \
        --timeout-graceful-shutdown 30 \
        --log-config vulpes/config/logging.json \
        >> "$LOG_DIR/vulpes.log" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
    # Import errors only show up once the app loads, so give it a moment to fail
    sleep 2
    if ! is_running; then
        rm -f "$PIDFILE"
        echo "uvicorn failed to start; see $LOG_DIR/vulpes.log" >&2
        exit 1
    fi
    echo "started (pid $(cat "$PIDFILE")) from $RELEASE_DIR"
}

stop() {
    if ! is_running; then
        echo "not running"
        return
    fi
    local pid
    pid=$(cat "$PIDFILE")
    # TERM is a graceful shutdown; workers get 30s (--timeout-graceful-shutdown) to finish requests
    kill -TERM "$pid"
    for _ in $(seq 40); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PIDFILE"
            echo "stopped"
            return
        fi
        sleep 1
    done
    echo "uvicorn (pid $pid) did not stop" >&2
    exit 1
}

import_flat() {
    local csv=${1:-}
    if [[ -z $csv ]]; then
        echo "usage: $0 import filtered_flat-YYYY_DD_MM.csv" >&2
        exit 2
    fi
    if [[ ! -f $csv ]]; then
        echo "no such file: $csv" >&2
        exit 1
    fi
    csv=$(readlink -f "$csv")
    "$RELEASE_DIR/.venv/bin/python" "$RELEASE_DIR/importer/build_duckdb.py" "$csv" \
        --out-dir "$(dirname "$DUCKDB_PATH")" \
        --memory-limit 6GB  # leaves the running app room in the server's 10 GiB
    if is_running; then
        reload
    fi
}

# Reloads the workers one at a time so the app keeps serving
reload() {
    if ! is_running; then
        echo "not running"
        return
    fi
    if (( WORKERS < 2 )); then
        stop
        start
        return
    fi
    kill -HUP "$(cat "$PIDFILE")"
    echo "reloading workers; see $LOG_DIR/vulpes.log"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    reload) reload ;;
    status)
        if is_running; then echo "running (pid $(cat "$PIDFILE"))"; else echo "not running"; fi
        ;;
    import) import_flat "${2:-}" ;;
    *)
        echo "usage: $0 start|stop|restart|reload|status|import <flat-export.csv>" >&2
        exit 2
        ;;
esac
